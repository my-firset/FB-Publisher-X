<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Group Lists"
        android:textColor="@color/on_background"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:boxBackgroundMode="outline"
        app:boxStrokeColor="@color/primary"
        android:layout_marginBottom="8dp">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inputGroupUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Group URL or ID"
            android:textColor="@color/on_surface"
            android:inputType="textUri" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:boxBackgroundMode="outline"
        app:boxStrokeColor="@color/primary"
        android:layout_marginBottom="8dp">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inputGroupName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Display name (optional)"
            android:textColor="@color/on_surface"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddGroup"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Add"
            android:textAllCaps="false"
            app:cornerRadius="10dp"
            app:backgroundTint="@color/primary" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClearGroups"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Clear All"
            android:textAllCaps="false"
            app:cornerRadius="10dp"
            app:backgroundTint="@color/surface_variant"
            app:strokeColor="@color/error"
            app:strokeWidth="1dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/groupsCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0 groups saved"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:layout_marginBottom="8dp" />

    <ListView
        android:id="@+id/listGroups"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@color/card_stroke"
        android:dividerHeight="1dp"
        android:background="@color/surface" />

</LinearLayout>
