<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:padding="16dp"
    android:layoutDirection="rtl">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/groups_title"
        android:textColor="@color/on_background"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSmartExtractor"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="@string/btn_smart_extractor"
        android:textAllCaps="false"
        android:textSize="15sp"
        android:layout_marginBottom="12dp"
        app:cornerRadius="12dp"
        app:backgroundTint="@color/primary"
        app:icon="@android:drawable/ic_menu_search"
        app:iconGravity="textStart"
        app:iconPadding="8dp" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:boxBackgroundMode="outline"
        app:boxStrokeColor="@color/primary"
        android:layout_marginBottom="8dp">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inputGroupUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_group_url"
            android:textColor="@color/on_surface"
            android:inputType="textUri"
            android:gravity="start" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:boxBackgroundMode="outline"
        app:boxStrokeColor="@color/primary"
        android:layout_marginBottom="8dp">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inputGroupName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_group_name"
            android:textColor="@color/on_surface"
            android:inputType="text"
            android:gravity="start" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:boxBackgroundMode="outline"
        app:boxStrokeColor="@color/primary"
        android:layout_marginBottom="8dp">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inputImportList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_import_list"
            android:textColor="@color/on_surface"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:gravity="start|top" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddGroup"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/btn_add_group"
            android:textAllCaps="false"
            app:cornerRadius="10dp"
            app:backgroundTint="@color/primary" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnImportGroups"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:text="@string/btn_import"
            android:textAllCaps="false"
            app:cornerRadius="10dp"
            app:backgroundTint="@color/secondary" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClearGroups"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/btn_clear_groups"
            android:textAllCaps="false"
            app:cornerRadius="10dp"
            app:backgroundTint="@color/surface_variant"
            app:strokeColor="@color/error"
            app:strokeWidth="1dp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnExportGroups"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="@string/btn_export"
        android:textAllCaps="false"
        android:layout_marginBottom="12dp"
        app:cornerRadius="10dp"
        app:backgroundTint="@color/surface"
        app:strokeColor="@color/primary"
        app:strokeWidth="1dp"
        app:icon="@android:drawable/ic_menu_save"
        app:iconGravity="textStart" />

    <TextView
        android:id="@+id/groupsCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0 مجموعة محفوظة"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:layout_marginBottom="8dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerGroups"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/surface"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />

</LinearLayout>
