<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/campaign_title"
            android:textColor="@color/on_background"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/post_text_label"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            app:boxBackgroundMode="outline"
            app:boxStrokeColor="@color/primary">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputPostText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_post_text"
                android:textColor="@color/on_surface"
                android:inputType="textMultiLine"
                android:minLines="5"
                android:gravity="start|top" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                app:boxBackgroundMode="outline"
                app:boxStrokeColor="@color/primary"
                app:suffixText="ث">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputMinDelay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_min_delay"
                    android:text="30"
                    android:textColor="@color/on_surface"
                    android:inputType="number"
                    android:gravity="start" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                app:boxBackgroundMode="outline"
                app:boxStrokeColor="@color/primary"
                app:suffixText="ث">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputMaxDelay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_max_delay"
                    android:text="60"
                    android:textColor="@color/on_surface"
                    android:inputType="number"
                    android:gravity="start" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/campaignInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0 مجموعة • جاهز"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginBottom="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStartCampaign"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/btn_start"
            android:textAllCaps="false"
            android:textSize="16sp"
            app:cornerRadius="12dp"
            app:backgroundTint="@color/primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStopCampaign"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/btn_stop"
            android:textAllCaps="false"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            app:cornerRadius="12dp"
            app:backgroundTint="@color/error" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetryFailed"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/btn_retry_failed"
            android:textAllCaps="false"
            android:layout_marginTop="8dp"
            app:cornerRadius="12dp"
            app:backgroundTint="@color/secondary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/campaign_log"
            android:textColor="@color/on_surface"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/campaignLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/waiting"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:background="@color/surface"
            android:padding="12dp"
            android:minHeight="160dp"
            android:gravity="start" />

    </LinearLayout>
</ScrollView>
